# Alertmanager configuration template.
#
# This file is NOT consumed directly by Alertmanager. Alertmanager has no
# native env var interpolation, so the container entrypoint (see
# docker-compose.yml) renders this template into
# /etc/alertmanager/alertmanager.yml before Alertmanager starts. The official
# prom/alertmanager image doesn't ship `envsubst`, so the entrypoint uses an
# equivalent awk/ENVIRON substitution to replace ${VAR} placeholders.
#
# Required environment variables (see .env.example):
#   SLACK_WEBHOOK_URL   - Slack incoming webhook URL
#   TELEGRAM_BOT_TOKEN  - Telegram bot token
#   TELEGRAM_CHAT_ID    - Telegram chat/channel ID to notify

global:
  resolve_timeout: 5m

route:
  receiver: slack-warnings
  group_by: ["alertname", "severity"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Critical alerts (e.g. ServiceDown, HighFunctionFailureRate) notify
    # both Slack and Telegram so they aren't missed if one channel is muted.
    - matchers:
        - severity="critical"
      receiver: critical-both
      group_wait: 10s
      repeat_interval: 1h

receivers:
  # Default receiver for warning-severity alerts (and anything unmatched).
  - name: slack-warnings
    slack_configs:
      - api_url: ${SLACK_WEBHOOK_URL}
        channel: "#alerts-warning"
        send_resolved: true
        title: '{{ template "slack.default.title" . }}'
        text: '{{ template "slack.default.text" . }}'

  # Critical-severity alerts go to both Slack and Telegram.
  - name: critical-both
    slack_configs:
      - api_url: ${SLACK_WEBHOOK_URL}
        channel: "#alerts-critical"
        send_resolved: true
        title: '{{ template "slack.default.title" . }}'
        text: '{{ template "slack.default.text" . }}'
    telegram_configs:
      - bot_token: ${TELEGRAM_BOT_TOKEN}
        chat_id: ${TELEGRAM_CHAT_ID}
        parse_mode: HTML
        message: '{{ template "telegram.default.message" . }}'
