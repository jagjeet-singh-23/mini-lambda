# Build stage
FROM golang:1.25.7-alpine AS builder

RUN apk add --no-cache git

WORKDIR /build

# Copy dependency files first (layer caching)
COPY shared/go.mod shared/go.sum ./shared/
COPY services/build-service/go.mod services/build-service/go.sum ./services/build-service/

# Download dependencies (cached!)
WORKDIR /build/shared
RUN go mod download

WORKDIR /build/services/build-service
RUN go mod download

# Copy source code
WORKDIR /build
COPY shared/ ./shared/
COPY services/build-service/ ./services/build-service/

# Build master binary
WORKDIR /build/services/build-service
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s -extldflags "-static"' \
    -a \
    -o build-master \
    ./cmd/master/main.go

# Runtime stage
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

COPY --from=builder /build/services/build-service/build-master .

RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8082

CMD ["./build-master"]

